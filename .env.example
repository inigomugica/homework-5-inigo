# Copy this file to .env (same folder) and put your real key in .env. Never commit .env.
PORTKEY_API_KEY=your-portkey-api-key-here
# Optional: Portkey-compatible base URL (this is the default)
OPENAI_BASE_URL=https://api.portkey.ai/v1
# Optional: name recorded as approved_by on payments
HUMAN_APPROVER=Your Name
